<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.org.irede.taskmanager.controller.TarefaFormController"
      stylesheets="@estilo.css">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Cadastro de Tarefa" styleClass="titulo-formulario"/>
    <GridPane hgap="10" vgap="10">
        <Label text="Título:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="campoTitulo"
                   promptText="Título obrigatório"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Descrição:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextArea fx:id="campoDescricao"
                  prefRowCount="5"
                  wrapText="true"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <CheckBox fx:id="checkConcluida"
                  text="Tarefa concluída"
                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="Salvar" onAction="#salvar" styleClass="botao-principal"/>
        <Button text="Cancelar" onAction="#cancelar"/>
    </HBox>
</VBox>